      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/artwork/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/categories/[slug]",
      "regex": "^/categories/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/categories/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/uploads/[id]/edit",
